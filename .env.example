# ============================= APP =============================
APP_NAME=shopping-precos-rag
ENVIRONMENT=dev            # dev | staging | prod
LOG_LEVEL=INFO
DATA_DIR=data

# =========================== INGESTÃO ==========================
HELPCENTER_BASE_URL=https://documentacao.shoppingdeprecos.com.br/pt
APIDOC_BASE_URL=https://apidoc.shoppingdeprecos.com.br
CRAWL_MAX_PAGES=400
CRAWL_CONCURRENCY=4
CRAWL_DELAY_SECONDS=0.3
REINDEX_INTERVAL_HOURS=0   # >0 liga reindexação incremental em background

# =========================== CHUNKING ==========================
CHUNK_SIZE=800             # presets: 300 | 500 | 800 | 1000
CHUNK_OVERLAP=100          # presets: 50 | 100 | 150

# ========================== EMBEDDINGS =========================
# fake = demo offline | openai | sentence-transformers
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=intfloat/multilingual-e5-small   # p/ sentence-transformers
OPENAI_EMBEDDING_MODEL=text-embedding-3-small    # ou text-embedding-3-large

# ======================== BANCO VETORIAL =======================
# memory = demo/testes | chroma | faiss (locais) | qdrant (produção)
VECTOR_BACKEND=chroma
COLLECTION_NAME=shopping_precos_docs
CHROMA_DIR=data/chroma
FAISS_DIR=data/faiss
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# =========================== RETRIEVAL =========================
RETRIEVAL_MODE=hybrid      # vector | bm25 | hybrid
TOP_K=5
FETCH_K=20
RRF_K=60
USE_MMR=false
MMR_LAMBDA=0.5
SCORE_THRESHOLD=0.0
USE_RERANKER=false         # exige sentence-transformers (bge) ou cohere
RERANKER_PROVIDER=bge      # bge | cohere
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
COHERE_API_KEY=

# ============================ GERAÇÃO ==========================
# fake = demo offline | openai | anthropic | gemini | ollama
LLM_PROVIDER=fake
LLM_MODEL=                 # vazio = default do provedor (gpt-4.1 / claude-sonnet-4-6 / ...)
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1200
MAX_CONTEXT_TOKENS=6000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ========================== CONVERSAÇÃO ========================
MEMORY_MAX_TURNS=6
ENABLE_CONDENSE=true
AGENT_MAX_EXTRA_QUERIES=2

# ============================ SEGURANÇA ========================
JWT_SECRET=troque-este-segredo-em-producao
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
AUTH_USERNAME=admin
AUTH_PASSWORD=admin
REQUIRE_AUTH_CHAT=false    # /ingest e /reindex SEMPRE exigem token
RATE_LIMIT_PER_MINUTE=30
MAX_QUESTION_CHARS=2000
BLOCK_PROMPT_INJECTION=false

# ======================== OBSERVABILIDADE ======================
CORS_ORIGINS=*
ENABLE_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
